    "Do you want to insert the image into the current canvas or open it as a new image?": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を現在のキャンバスに挿入しますか?それとも新しい画像として開きますか?"
          }
        }
      }
    },
