    "More undo levels use more memory. Applies to open documents immediately.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消し回数を増やすと、より多くのメモリを使用します。開いている書類にはすぐに反映されます。"
          }
        }
      }
    },
