{
  "sourceLanguage": "en",
  "strings": {
    "A language change takes effect after relaunching the app.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の変更は、アプリを再起動すると反映されます。"
          }
        }
      }
    },
    "A smaller cache size takes effect as new images are loaded.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュサイズを小さくした場合は、新しい画像が読み込まれるにつれて反映されます。"
          }
        }
      }
    },
